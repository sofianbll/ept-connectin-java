put {
  url: {{base_url}}/user/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "firstName": "Sofian",
    "lastName": "V2"
  }
}

tests {
  test("Response must be [200]", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
