meta {
  name: Toggle Like
  type: http
  seq: 1
}

post {
  url: {{base_url}}/posts/1/like
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Response must be [200]", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Correct : Response contains is_liked and likes_count", function() {
    const data = res.getBody();
    expect(data).to.have.property('is_liked').that.is.a('boolean');
    expect(data).to.have.property('likes_count').that.is.a('number');
  });
}
