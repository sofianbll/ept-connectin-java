meta {
  name: Search Users
  type: http
  seq: 3
}

get {
  url: {{base_url}}/users/search?q=so
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Response must be [200]", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Correct : response contains array of users", function() {
    expect(res.getBody()).to.be.an('array');
  });
}
