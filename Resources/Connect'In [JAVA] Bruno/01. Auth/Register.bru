meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{base_url}}/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Sofian",
    "lastName": "User",
    "email": "sofian@epitech.eu",
    "password": "password",
    "password_confirmation": "password"
  }
}

tests {
  test("Status must be [201] OR [200]", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("Response contains access_token", function() {
    expect(res.getBody()).to.have.property("access_token");
  });

  test("Response contains user object", function() {
    const data = res.getBody();
    expect(data).to.have.property("user");
    expect(data.user).to.have.property("id");
    expect(data.user).to.have.property("firstName");
  });
}
