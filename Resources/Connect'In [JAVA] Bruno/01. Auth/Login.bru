meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "sofian@epitech.eu",
    "password": "password"
  }
}

script:post-response {
  let data = res.getBody();
  if (res.getStatus() === 200 && data.token) {
    bru.setEnvVar("access_token", data.token);
  }
}

tests {
  test("Status must be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains token", function() {
    expect(res.getBody()).to.have.property("token");
  });
}
