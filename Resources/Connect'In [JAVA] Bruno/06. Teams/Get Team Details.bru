meta {
  name: Get Team Details
  type: http
  seq: 2
}

get {
  url: {{base_url}}/teams/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Response must be [200]", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Correct : Response contain all the good entry", function() {
    const team = res.getBody();
    expect(team).to.have.property('id');
    expect(team).to.have.property('name');
    expect(team).to.have.property('owner_id');
    expect(team).to.have.property('members').that.is.an('array');
  });
}
