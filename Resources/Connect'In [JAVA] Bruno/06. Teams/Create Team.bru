meta {
  name: Create Team
  type: http
  seq: 1
}

post {
  url: {{base_url}}/teams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Team du futur",
    "description": "futur descirptions"
  }
}

tests {
  test("Response must be [201]", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  
  test("Correct : response contains id and owner_id", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('owner_id');
  });
}
