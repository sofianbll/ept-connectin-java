meta {
  name: Edit Comment
  type: http
  seq: 2
}

put {
  url: {{base_url}}/comments/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "text": "New edited comment"
  }
}

tests {
  test("Response must be [200]", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Correct : Response contains the updated text", function() {
    const data = res.getBody();
    expect(data).to.have.property('text');
  });
}
